<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:layoutDirection="rtl"
    tools:context=".MainActivity">

    <!-- الحاوية الرئيسية للشريط العلوي -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="#151C2C"
        android:elevation="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="6dp">

        <!-- الصف الأول: أدوات التنقل وحقل الرابط وزر اللعبة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- زر الرجوع للخلف -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_back"
                android:tint="#E2E8F0" />

            <!-- زر التقدم للأمام -->
            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/forward"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_forward"
                android:tint="#94A3B8" />

            <!-- زر إعادة التحميل -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_refresh"
                android:tint="#E2E8F0" />

            <!-- حقل إدخال الرابط والبحث -->
            <EditText
                android:id="@+id/etUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/url_input_bg"
                android:hint="@string/url_placeholder"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <!-- زر تشغيل اللعبة البارز (الوصول المباشر للرابط المطلوب) -->
            <LinearLayout
                android:id="@+id/btnPlayGame"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/btn_game_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gamepad"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_game"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- زر وضع ملء الشاشة -->
            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen"
                android:tint="#00E5FF" />

        </LinearLayout>

        <!-- الصف الثاني: شريط المعلومات السريع وتسريع الأجهزة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvGpuBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ تسريع عتادي GPU + WebGL مفعّل"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDirectPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="🎮 بدء فوري للعبة"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOpenInChrome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="🚀 فتح في Chrome"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClearCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="مسح الذاكرة"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvToggleDesktop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="وضع الهاتف"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- شريط تقدم التحميل الأفقي -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_custom"
            android:visibility="gone" />

    </LinearLayout>

    <!-- مساحة عرض الـ WebView الرئيسية -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarLayout">

        <!-- الـ WebView المسرع بالعتاد (Hardware Accelerated WebView) -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0F19" />

        <!-- واجهة الخطأ عند فقدان الاتصال -->
        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0F19"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_refresh"
                android:tint="#EF4444" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/error_loading"
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FF6D00"
                android:text="@string/retry"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- حاوية وضع ملء الشاشة للألعاب وفيديوهات HTML5 Canvas -->
        <FrameLayout
            android:id="@+id/customViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- زر عائم خفي/شبه شفاف للخروج من وضع ملء الشاشة في الألعاب -->
    <ImageButton
        android:id="@+id/btnExitFullscreenFloating"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:background="@drawable/url_input_bg"
        android:contentDescription="@string/exit_fullscreen"
        android:elevation="10dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fullscreen"
        android:visibility="gone"
        android:tint="#FF6D00" />

</RelativeLayout>
